{
  "name": "pwarmyar-desktop",
  "version": "3.0.4",
  "private": true,
  "description": "PwarMyar online SPA shell with offline POS and SQLite sale queue",
  "main": "main.cjs",
  "author": "PwarMyar",
  "license": "UNLICENSED",
  "scripts": {
    "build:renderer": "npm --prefix ../frontend run build:desktop",
    "check:server": "node --use-system-ca scripts/check-live-server.cjs",
    "dev": "npm run build:renderer && electron .",
    "test": "node --test test/*.test.cjs",
    "dist:portable": "npm run build:renderer && electron-builder --win portable --x64 && electron-builder --win portable --ia32",
    "dist:portable:x64": "npm run build:renderer && electron-builder --win portable --x64",
    "dist:portable:ia32": "npm run build:renderer && electron-builder --win portable --ia32",
    "dist:installer": "npm run build:renderer && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.8.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pwarmyar.desktop",
    "productName": "PwarMyar",
    "asar": true,
    "afterPack": "./scripts/verify-package.cjs",
    "directories": {
      "output": "../release/electron"
    },
    "files": [
      "main.cjs",
      "api-proxy.cjs",
      "preload.cjs",
      "runtime.cjs",
      "theme.cjs",
      "offline-store.cjs",
      "printing.cjs",
      "escpos.cjs",
      "serial.cjs",
      "printer-config.cjs",
      "printer-preferences.cjs",
      {
        "from": "../frontend/dist-desktop",
        "to": "renderer"
      },
      "splash.html",
      "branding/**",
      "config.default.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "serial-print.ps1",
        "to": "serial-print.ps1"
      },
      {
        "from": "../frontend/dist-desktop",
        "to": "frontend"
      },
      {
        "from": "config.default.json",
        "to": "config.default.json"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "branding/app.ico",
      "artifactName": "PwarMyar-${version}-Portable-${arch}.${ext}",
      "executableName": "PwarMyar"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PwarMyar",
      "artifactName": "PwarMyar-${version}-Setup-${arch}.${ext}",
      "installerIcon": "branding/app.ico",
      "uninstallerIcon": "branding/app.ico"
    }
  }
}
