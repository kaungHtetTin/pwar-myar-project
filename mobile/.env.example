# Leave blank when the SPA and Laravel are served from the same origin.
VITE_API_URL=/api
VITE_AUTH_MODE=session

# Optional override when the customer app has its own domain.
# Otherwise development uses port 5177; production uses the API server's /shop/.
VITE_SHOP_URL=

# Vite-only development proxy target.
VITE_DEV_API_ORIGIN=http://127.0.0.1:8000

# Use / for standalone hosting or a subpath such as /mobile/.
VITE_BASE_PATH=/

# Android APK builds default to the live production API below.
# Production: https://www.pwarmyar.com/public/api
# Local Wi-Fi example: http://192.168.1.22:8000/api
# Do not use localhost/127.0.0.1: those addresses point to the phone itself.
