# Store this file outside a public document root. Fill CHAT_SECRET privately
# with the exact same value as Laravel SHOP_CHAT_APP_SECRET (at least 32 chars).
NODE_ENV=production
CHAT_HOST=127.0.0.1
CHAT_PORT=8080
CHAT_SOCKET_PATH=/socket.io
CHAT_SECRET=
# Optional AI queue wakeups: set both values together, using the same new secret
# as Laravel AI_NODE_DISPATCH_SECRET. See deploy/AI-JOBS.md.
# Callback: https://www.pwarmyar.com/public/integrations/ai-jobs/process
AI_JOBS_CALLBACK_URL=
AI_JOBS_SECRET=
CHAT_ALLOWED_ORIGINS=https://www.pwarmyar.com,https://pwarmyar.com,https://localhost,capacitor://localhost,file://,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175,http://127.0.0.1:5176,http://localhost:5176,http://127.0.0.1:5177,http://localhost:5177,http://127.0.0.1:8000,http://localhost:8000,https://shop.pwarmyar.com,https://pos.pwarmyar.com,https://office.pwarmyar.com,https://mobilepos.pwarmyar.com,https://socket.pwarmyar.com
